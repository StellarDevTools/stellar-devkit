{
  "name": "@stellar-devkit/mcp-server",
  "version": "0.1.0",
  "description": "MCP server integration for Stellar DevKit",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "stellar-devkit-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --shims",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:stdio": "vitest run --config vitest.stdio.config.ts",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@stellar-devkit/core": "workspace:*",
    "@stellar-devkit/diagnostics": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
