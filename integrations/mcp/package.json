{
  "name": "@stellar-devkit/mcp-server",
  "version": "0.1.0",
  "description": "MCP server integration for Stellar DevKit",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "stellar-devkit-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --shims",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar-devkit/core": "workspace:*",
    "@stellar-devkit/diagnostics": "workspace:*",
    "@modelcontextprotocol/sdk": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
